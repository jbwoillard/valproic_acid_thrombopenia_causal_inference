*.html
*.pdf
reports/final_report.html
analysis.html

# --- CSV results (regenerated) ---
outputs/

# --- R environment ---
.Rproj.user/
.Rhistory
.RData
*.Rproj

# --- OS ---
.DS_Store
Thumbs.db

# --- Temporary / editor ---
*.tmp
*.bak
*~
*.swp
.venv/

# --- Archives ---
archive/
